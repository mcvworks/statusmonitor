generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth.js Models ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  dashboards        UserDashboard[]
  stack             UserStack[]
  notificationPrefs UserNotificationPref[]
  alertStates       UserAlertState[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Alert ──────────────────────────────────────────────────────

model Alert {
  id               String    @id @default(cuid())
  externalId       String
  source           String
  category         String // cloud, security, isp, devops
  severity         String // critical, major, minor, info
  title            String
  description      String?
  url              String?
  region           String?
  timestamp        DateTime
  status           String // active, resolved, investigating, monitoring
  signalKind       String    @default("incident") // incident, advisory, internet_outage, community_signal, maintenance
  confidence       String    @default("official") // official, corroborated, observed, crowdsourced
  previousSeverity String? // tracks escalation/de-escalation
  metadata         String? // JSON: incident updates, CVSS vectors, components, etc.
  resolvedAt       DateTime?
  expiresAt        DateTime? // observations without an explicit resolution expire here
  lastObservedAt   DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  alertStates           UserAlertState[]
  notificationLogs      NotificationLog[]
  emailSubscriptionLogs EmailSubscriptionLog[]
  updates               AlertUpdate[]

  @@unique([source, externalId])
}

model AlertUpdate {
  id              String   @id @default(cuid())
  alertId         String
  sourceTimestamp DateTime
  status          String?
  body            String
  createdAt       DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, sourceTimestamp, body])
  @@index([alertId, sourceTimestamp])
}

// ─── User Dashboard & Preferences ──────────────────────────────

model UserDashboard {
  id             String   @id @default(cuid())
  userId         String
  name           String
  layout         String // JSON stored as text (SQLite)
  pinnedServices String // JSON stored as text
  filters        String // JSON stored as text
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStack {
  id          String   @id @default(cuid())
  userId      String
  serviceName String
  provider    String
  region      String?
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotificationPref {
  id             String   @id @default(cuid())
  userId         String
  channel        String // email, slack, teams, push
  enabled        Boolean  @default(true)
  config         String // JSON stored as text (webhook URL, etc.)
  severityFilter String // JSON stored as text
  sourceFilter   String // JSON stored as text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAlertState {
  id           String    @id @default(cuid())
  userId       String
  alertId      String
  state        String // acknowledged, snoozed, dismissed
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([userId, alertId])
}

// ─── Push Notifications ─────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Audit Logs ─────────────────────────────────────────────────

model NotificationLog {
  id      String   @id @default(cuid())
  userId  String
  channel String
  alertId String
  sentAt  DateTime @default(now())
  success Boolean
  error   String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

// Public, passwordless email alerts. Kept separate from Auth.js users so a
// visitor can subscribe without creating an account.
model EmailSubscription {
  id                    String    @id @default(cuid())
  email                 String    @unique
  enabled               Boolean   @default(false)
  verifiedAt            DateTime?
  severityFilter        String    @default("[]")
  sourceFilter          String    @default("[]")
  pendingSeverityFilter String?
  pendingSourceFilter   String?
  confirmationTokenHash String?   @unique
  confirmationExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  notificationLogs EmailSubscriptionLog[]
}

model EmailSubscriptionLog {
  id             String   @id @default(cuid())
  subscriptionId String
  alertId        String
  eventKey       String
  sentAt         DateTime @default(now())
  success        Boolean
  error          String?

  subscription EmailSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  alert        Alert             @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, alertId, eventKey])
  @@index([subscriptionId, sentAt])
}

model PollLog {
  id            String    @id @default(cuid())
  provider      String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  alertsFound   Int       @default(0)
  newAlerts     Int       @default(0)
  updatedAlerts Int       @default(0)
  error         String?
}

model ProviderState {
  id                  String    @id @default(cuid())
  provider            String    @unique
  lastAttemptAt       DateTime
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastError           String?
  consecutiveFailures Int       @default(0)
  lastAlertCount      Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

// ─── Dependency Map ─────────────────────────────────────────────

model DependencyMap {
  id               String   @id @default(cuid())
  provider         String
  dependentService String
  confidence       String // confirmed, likely, possible
  region           String?
  source           String
  updatedAt        DateTime @updatedAt
}

// ─── Feedback ───────────────────────────────────────────────────

model Feedback {
  id        String   @id @default(cuid())
  message   String
  email     String?
  page      String?
  userAgent String?
  createdAt DateTime @default(now())
}
